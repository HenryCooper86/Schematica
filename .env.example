# Hostname only; point its DNS record to your Lightsail static IP.
SCHEMATICA_DOMAIN=schematica.example.com

# To use a public static IP with a trusted short-lived certificate instead:
# SCHEMATICA_DOMAIN=YOUR_STATIC_IP
# CADDY_CONFIG=./deploy/Caddyfile.ip

# Optional extra provider base URLs, configured by the server operator.
# AI_BASE_URLS=https://your-provider.example/v1
